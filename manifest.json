{
  "manifest_version": 3,
  "name": "ScribbleTab",
  "version": "1.0.0",
  "description": "An elegant, lightweight viewport drawing canvas. Sketch notes, drop shapes, and capture composited screenshots instantly.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["content/content.css"],
      "js": [
        "content/canvas-overlay.js",
        "content/toolbar.js",
        "content/tools/freehand.js",
        "content/tools/rectangle.js",
        "content/tools/circle.js",
        "content/tools/arrow.js",
        "content/tools/eraser.js",
        "content/drawing-engine.js",
        "content/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "ScribbleTab Active Workspace",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}